---
import folderIcon from '../assets/images/folder.png';
import { getIcon } from '../data/icons';
import type { FolderItem } from '../data/items';

interface Props {
  item: FolderItem;
  nested?: boolean;
}
const { item, nested = false } = Astro.props;
---

<div
  class:list={['file', 'folder', { 'in-window': nested }]}
  role="button"
  tabindex="0"
  data-open={item.id}
  data-x={item.x}
  data-y={item.y}
  data-name={item.name}
  title={item.name}
>
  <img src={getIcon(item.icon, folderIcon).src} alt="" />
  <div class="name">
    <p>{item.name}</p>
  </div>
</div>