---
import { asset } from '../../data/assets';

const img = (name: string) => asset(`images/fakesites/${name}`);
---

<div class="home">
  <div class="hint">
    <img src={img('arrow.gif')} alt="" />
    <p>Click the arrows to change the page</p>
  </div>

  <img class="photo" src={img('me.png')} alt="Portrait" />

  <img class="bar" src={img('bluebar.gif')} alt="" />
  <div class="title">
    <img src={img('computer.gif')} alt="" />
    <div>
      <p class="name">Aleksa Milić</p>
      <p class="role">Frontend Developer</p>
    </div>
    <img src={img('palette.gif')} alt="" />
  </div>
  <img class="bar" src={img('bluebar.gif')} alt="" />

  <div class="welcome">
    <img src={img('waveemoji.gif')} class="wave" alt="" />
    <div>
      <img src={img('welcome.gif')} class="big" alt="Welcome" />
      <p class="small">To My Portfolio!!!</p>
    </div>
    <img class="wave flip" src={img('waveemoji.gif')} alt="" />
  </div>

  <div class="badges">
    <img src={img('notepad.gif')} alt="Site created with Notepad" />
    <img src={img('noframes.gif')} alt="Campaign against frames" />
    <img src={img('netscape.gif')} alt="Netscape now" />
    <img src={img('explorer.gif')} alt="Internet Explorer" />
  </div>
</div>

<style lang="scss">
  .home {
    position: relative;
    padding: 1cqw 0 4cqw;
    background-color: #000;
    background-image: url('/images/fakesites/stars.gif');
    text-align: center;
    font-family: 'Comic Sans MS', 'Comic Neue', 'Chalkboard SE', cursive;

    p {
      margin: 0;
    }
  }

  .hint {
    position: fixed;
    margin-top: 10px;

    img {
      width: 7cqw;
      transform: rotate(-70deg);
    }

    p {
      position: absolute;
      top: 3.8cqw;
      left: 4.5cqw;
      width: 16cqw;
      font-size: 2cqw;
      line-height: 1.15;
      color: #ffff33;
    }
  }

  .photo {
    display: block;
    width: 33cqw;
    margin: 3cqw auto 2cqw;
  }

  .bar {
    display: block;
    width: 55cqw;
    height: auto;
    margin: 0 auto;
  }

  .title {
    width: 60cqw;
    margin: 0 auto;
    padding: 2cqw 4cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;

    img {
      width: 6cqw;
      flex: none;
    }

    img:first-child {
      width: 11cqw;
    }

    img:last-child {
      margin-left: 1.5cqw;
    }
  }

  .name {
    font-size: 3cqw;
    color: #00ffcc;
  }

  .role {
    font-size: 3.6cqw;
    color: #ff00ff;
  }

  .welcome {
    width: 65cqw;
    margin: 4.5cqw auto 0;
    padding: 4.5cqw 3cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #f00;

    .wave {
      width: 10cqw;
      flex: none;
    }

    .flip {
      transform: scaleX(-1);
    }
  }

  .big {
    width: 100%;
    margin: -50px 0 -40px 0;
  }

  .small {
    font-family: 'Times New Roman', Times, serif;
    font-weight: bold;
    font-size: 4.2cqw;
    color: #1fe01f;
    text-shadow: 0.15cqw 0.15cqw 0 #006400;
  }

  .badges {
    margin-top: 5cqw;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2cqw;

    img {
      height: 5cqw;
      width: auto;
    }
  }
</style>