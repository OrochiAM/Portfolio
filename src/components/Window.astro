---
import closeIcon from '../assets/images/x.png';
import minimizeIcon from '../assets/images/minimize.png';
import File from './File.astro';
import Folder from './Folder.astro';
import type { Item } from '../data/items';
import folderIcon from '../assets/images/folder.png';
import { getIcon } from '../data/icons';
import { pathOf } from '../data/items';


interface Props {
  item: Item;
}
const { item } = Astro.props;

const path = item.kind === 'folder' ? pathOf(item) : undefined;
---

<div class="window gone" data-window={item.id}>
  <div class="header" title={item.name}>
    <div class="text">
      <p>{item.title}</p>
    </div>
      <div class="buttons">
      <div class="minimize btn-minimize" title="Minimize">
        <img src={minimizeIcon.src} alt="Minimize" />
      </div>
      <div class="close btn-close" title="Close">
        <img src={closeIcon.src} alt="Close" />
      </div>
    </div>
  </div>
  <div class="body">
    {
      item.kind === 'folder' ? (
        <div class="folder-view">
  <div class="toolbar">
    <div class="address">
      <img src={getIcon(item.icon, folderIcon).src} alt="" />
      <span>{path}</span>
    </div>
    <input class="search" type="text" placeholder="Search" />
  </div>
  <div class="folder-grid">
    {item.children.map((child) =>
      child.kind === 'folder' ? <Folder item={child} nested /> : <File item={child} nested />,
    )}
  </div>
</div>
      ) : item.content.type === 'iframe' ? (
        <iframe src={item.content.src} title={item.title} />
      ) : (
        <div class="text">
          <p>{item.content.text}</p>
        </div>
      )
    }
  </div>
</div>