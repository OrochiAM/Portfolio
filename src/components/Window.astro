---
import { asset } from '../data/assets';
import type { Item } from '../data/items';
import FolderView from './window/FolderView.astro';
import IframeView from './window/IframeView.astro';
import TextView from './window/TextView.astro';
import BrowserView from './window/BrowserView.astro';

interface Props {
  item: Item;
}
const { item } = Astro.props;
---

<div class="window gone" data-window={item.id} data-x={item.x} data-y={item.y}>
  <div class="header">
    <div class="text">{item.title}</div>
    <div class="buttons">
      <div class="minimize btn-minimize"><img src={asset('images/minimize.png')} alt="Minimize" /></div>
      <div class="close btn-close"><img src={asset('images/close.png')} alt="Close" /></div>
    </div>
  </div>

  <div class="body">
    {item.kind === 'folder' && <FolderView item={item} />}
    {item.kind === 'file' && item.content.type === 'iframe' && (
      <IframeView src={item.content.src} title={item.title} />
    )}
    {item.kind === 'file' && item.content.type === 'text' && <TextView text={item.content.text} />}
    {item.kind === 'file' && item.content.type === 'browser' && (
      <BrowserView pages={item.content.pages} />
    )}
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';
  import { minimizeItem, closeItem } from '../scripts/windows';

  gsap.registerPlugin(Draggable);

  document.querySelectorAll<HTMLElement>('.window').forEach((win, i) => {
    const id = win.dataset.window!;
    gsap.set(win, {
      x: Number(win.dataset.x ?? 150 + i * 20),
      y: Number(win.dataset.y ?? 60 + i * 20),
    });
    Draggable.create(win, { zIndexBoost: true, dragClickables: false });

    win.querySelector('.btn-minimize')!.addEventListener('click', () => minimizeItem(id));
    win.querySelector('.btn-close')!.addEventListener('click', () => closeItem(id));
  });
</script>