---
import startMeh from '../assets/images/start-meh.png';
import start from '../assets/images/start.png';
import fileIcon from '../assets/images/file.png';
import folderIcon from '../assets/images/folder.png';
import { getIcon } from '../data/icons';
import { items, flatten, pathOf } from '../data/items';
import type { Item } from '../data/items';

const all = flatten(items);
const iconOf = (item: Item) =>
  getIcon(item.icon, item.kind === 'folder' ? folderIcon : fileIcon).src;
---

<footer>
  <div class="left">
    <div class="start">
      <div class="start-menu gone">
        <div class="start-banner"><span>PORTFOLIO</span></div>
        <ul class="start-list">
          {
            all.map((item) => (
              <li class="start-item" data-start={item.id} title={pathOf(item)}>
                <img src={iconOf(item)} alt="" />
                <span>{item.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <img
        src={startMeh.src}
        class="btn-start"
        data-closed={startMeh.src}
        data-open={start.src}
        alt="Start"
      />
    </div>

    <div class="file-tray">
      {
        all.map((item) => (
          <div
            class="file-tray-item gone"
            data-tray={item.id}
            title={item.name}
          >
            <img src={iconOf(item)} alt="" />
            <p>{item.title}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="right">
    <div class="info">
      <p class="time">20:25</p>
      <p class="date">5.9.2069</p>
    </div>
  </div>
</footer>