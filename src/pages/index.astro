---
import Layout from '../layouts/Layout.astro';
import File from '../components/File.astro';
import Window from '../components/Window.astro';
import Taskbar from '../components/Taskbar.astro';
import SelectBox from '../components/SelectBox.astro';
import { items, flatten } from '../data/items';
---

<Layout title="Portfolio">
  <SelectBox />
  {items.map((item) => <File item={item} />)}
  {flatten(items).map((item) => <Window item={item} />)}
  <Taskbar />
</Layout>